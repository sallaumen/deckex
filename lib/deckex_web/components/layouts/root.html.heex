<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="deckex" suffix=" · A Mesa" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- The fonts are ours, served from priv/static/fonts and declared in
          assets/css/fonts.css. Preloading the two Latin subsets means the text
          paints in the right face on first render instead of swapping after
          the stylesheet parses. --%>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/archivo-latin.woff2"}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/azeret-mono-latin.woff2"}
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
